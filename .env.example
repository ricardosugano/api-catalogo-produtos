# Porta do servidor HTTP
PORT=3001

# ---- PostgreSQL local (docker compose) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Porta do Postgres exposta na sua máquina (use 5433 se já tiver um Postgres local na 5432)
DB_PORT_HOST=5432

# ---- Supabase (descomente e preencha para usar o banco na nuvem) ----
# DB_HOST=db.SEU-PROJETO.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=sua_senha_do_supabase
# DB_SSL=true

# true = cria/ajusta a tabela automaticamente ao subir o servidor (sequelize.sync)
# false = use as migrations (pnpm db:migrate)
DB_SYNC=false
